APP_NAME="Chatbot Deka"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_EMAIL_LOGO_URL=https://i.ibb.co.com/hJ5LLkyv/Whats-App-Image-2026-07-13-at-15-06-30-removebg-preview.png

ADMIN_NAME="Admin Deka"
ADMIN_EMAIL=admin@deka.dev
ADMIN_PASSWORD=password

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5433
DB_DATABASE=chatbot_deka
DB_USERNAME=chatbot_deka
DB_PASSWORD=secret

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=resend
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="onboarding@resend.dev"
MAIL_FROM_NAME="${APP_NAME}"
RESEND_API_KEY=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
# Isi hanya jika Vite/HMR diekspos melalui tunnel HTTPS terpisah ke port 5173.
VITE_DEV_SERVER_URL=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

OPENAI_API_KEY=
OPENAI_URL=https://codex.deka.dev/v1

AI_CHAT_PROVIDER=openai
AI_CHAT_MODEL=gpt-5.4-mini
AI_CHAT_TIMEOUT=30
AI_CHAT_STREAMING_ENABLED=false
AI_CHAT_STREAM_SAFETY_MODE=buffered

AI_CHAT_CURL_STREAMING_ENABLED=false
AI_CHAT_MODERATION_ENABLED=false
AI_CHAT_OUTPUT_MODERATION_ENABLED=false

DEKA_KNOWLEDGE_ENABLED=true
DEKA_KNOWLEDGE_RETRIEVAL_MODE=hybrid
DEKA_KNOWLEDGE_BASE_URL=https://deka.dev
DEKA_KNOWLEDGE_EMBEDDING_PROVIDER=gemini
DEKA_KNOWLEDGE_EMBEDDING_MODEL=gemini-embedding-001
DEKA_KNOWLEDGE_EMBEDDING_DIMENSIONS=1536
DEKA_KNOWLEDGE_TOP_K=5
DEKA_KNOWLEDGE_CANDIDATE_LIMIT=20
DEKA_KNOWLEDGE_QUERY_REWRITE_ENABLED=true
DEKA_KNOWLEDGE_QUERY_REWRITE_LIMIT=5
DEKA_KNOWLEDGE_RERANK_ENABLED=true
DEKA_KNOWLEDGE_VALIDATION_ENABLED=true
DEKA_KNOWLEDGE_VALIDATION_PROBE_COUNT=3
DEKA_KNOWLEDGE_VALIDATION_TIMEOUT=60
DEKA_KNOWLEDGE_MIN_ACTIVE_DOCUMENTS_FOR_READY=3
DEKA_KNOWLEDGE_MIN_ACTIVE_CHUNKS_FOR_READY=20
DEKA_KNOWLEDGE_MIN_SIMILARITY=0.72
DEKA_KNOWLEDGE_MIN_FULLTEXT_SCORE=0.01
DEKA_KNOWLEDGE_MAX_CONTEXT_CHARACTERS=12000
DEKA_KNOWLEDGE_CHUNK_SIZE=1200
DEKA_KNOWLEDGE_CHUNK_OVERLAP=180
DEKA_KNOWLEDGE_SCHEDULED_CRAWL_ENABLED=false
DEKA_KNOWLEDGE_SCHEDULED_CRAWL_TIME=02:00
DEKA_KNOWLEDGE_SCHEDULED_CRAWL_LIMIT=50
